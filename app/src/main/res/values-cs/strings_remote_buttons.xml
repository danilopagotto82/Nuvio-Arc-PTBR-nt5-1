    <string name="remote_buttons_reset">Obnovit všechna tlačítka</string>
    <string name="remote_buttons_mapper_note">Používáte tvQuickActions nebo Button Mapper? Nastavte tam tlačítko tak, aby posílalo klávesu, například Červené nebo Info, a pak zde vyberte funkci této klávesy.</string>
