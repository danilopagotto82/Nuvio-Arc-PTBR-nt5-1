    <string name="remote_buttons_section_title">Dugmad daljinskog</string>
    <string name="remote_buttons_section_desc">Dodelite funkcije dugmadi daljinskog tokom gledanja.</string>
    <string name="remote_buttons_intro">OK, strelice i „Nazad“ uvek zadržavaju svoje uobičajene funkcije. Jačinom zvuka upravlja uređaj ili televizor.</string>
    <string name="remote_buttons_setup_title">Podesi dugme</string>
    <string name="remote_buttons_setup_subtitle">Pritisnite ga na daljinskom, pa izaberite funkciju</string>
    <string name="remote_buttons_reset">Resetuj svu dugmad</string>
    <string name="remote_buttons_mapper_note">Koristite tvQuickActions ili Button Mapper? Tamo podesite dugme da šalje taster, na primer „Crveno“ ili „Info“, pa ovde izaberite funkciju tog tastera.</string>
    <string name="remote_buttons_number_keys">Dugmad sa brojevima</string>
