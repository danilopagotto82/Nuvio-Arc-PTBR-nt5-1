    <string name="remote_buttons_section_title">Fjernkontrollknapper</string>
    <string name="remote_buttons_section_desc">Gi knappene på fjernkontrollen en funksjon mens du ser.</string>
    <string name="remote_buttons_intro">OK, pilene og Tilbake beholder alltid sine vanlige funksjoner. Volumet styres fortsatt av boksen eller TV-en.</string>
    <string name="remote_buttons_setup_title">Sett opp en knapp</string>
    <string name="remote_buttons_setup_subtitle">Trykk på den på fjernkontrollen, og velg så funksjon</string>
    <string name="remote_buttons_reset">Tilbakestill alle knapper</string>
    <string name="remote_buttons_mapper_note">Bruker du tvQuickActions eller Button Mapper? Still inn knappen der til å sende en tast, for eksempel Rød eller Info, og velg så tastens funksjon her.</string>
