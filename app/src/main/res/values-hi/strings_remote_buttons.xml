<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Nuvio-test additions -->
    <string name="remote_buttons_section_title">रिमोट बटन</string>
    <string name="remote_buttons_section_desc">देखते समय रिमोट बटनों को कोई काम दें।</string>
    <string name="remote_buttons_intro">OK, ऐरो और बैक हमेशा अपना सामान्य काम करते हैं। वॉल्यूम आपका डिवाइस या TV ही संभालता है।</string>
    <string name="remote_buttons_setup_title">बटन सेट करें</string>
    <string name="remote_buttons_setup_subtitle">इसे अपने रिमोट पर दबाएँ, फिर इसका काम चुनें</string>
    <string name="remote_buttons_reset">सभी बटन रीसेट करें</string>
    <string name="remote_buttons_mapper_note">tvQuickActions या Button Mapper इस्तेमाल करते हैं? वहाँ अपने बटन को कोई दूसरा बटन भेजने के लिए सेट करें, जैसे लाल या इन्फो, फिर यहाँ उस बटन का काम चुनें।</string>
    <string name="remote_buttons_number_keys">नंबर बटन</string>
    <string name="remote_buttons_number_keys_desc">1 = 10 %, 5 = आधा, 0 = शुरुआत</string>
    <string name="remote_buttons_added">इस डिवाइस पर सेट</string>
    <string name="remote_buttons_learn_title">बटन सेट करें</string>
    <string name="remote_buttons_learn_subtitle">रिमोट पर वह बटन दबाएँ जिसे आप कोई काम देना चाहते हैं। बैक दबाने पर रद्द।</string>
    <string name="remote_buttons_learn_waiting">बटन का इंतज़ार…</string>
    <string name="remote_buttons_learn_nothing">अभी तक कुछ नहीं आया। कुछ बटन, जैसे होम, माइक्रोफ़ोन, वॉल्यूम और Netflix या YouTube बटन, आपके डिवाइस के होते हैं और ऐप तक कभी नहीं पहुँचते। अगर आप TV का रिमोट इस्तेमाल करते हैं, तो हो सकता है आपका TV यह बटन डिवाइस तक न भेजे। कोई दूसरा बटन आज़माएँ, या tvQuickActions जैसे बटन-मैपर ऐप से उस बटन को खाली करें।</string>
    <string name="remote_buttons_learn_locked">%1$s को बदला नहीं जा सकता। OK, ऐरो और बैक हमेशा अपना सामान्य काम करते हैं, ताकि कोई भी प्लेयर में फँस न जाए। कोई दूसरा बटन दबाएँ।</string>
    <string name="remote_buttons_learn_volume">वॉल्यूम आपका डिवाइस या TV ही संभालता है। कोई दूसरा बटन दबाएँ।</string>
