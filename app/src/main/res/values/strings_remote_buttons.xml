<resources>
    <string name="remote_buttons_section_title">Remote buttons</string>
    <string name="remote_buttons_section_desc">Give remote buttons a job while you watch.</string>
    <string name="remote_buttons_intro">OK, the arrows and Back always keep their usual jobs. Volume stays with your box or TV.</string>
    <string name="remote_buttons_setup_title">Set up a button</string>
    <string name="remote_buttons_setup_subtitle">Press it on your remote, then choose its job</string>
    <string name="remote_buttons_reset">Reset all buttons</string>
    <string name="remote_buttons_mapper_note">Using tvQuickActions or Button Mapper? Set your button there to send a key, for example Red or Info, then choose that key\'s job here.</string>
    <string name="remote_buttons_number_keys">Number keys</string>
    <string name="remote_buttons_number_keys_desc" formatted="false">1 = 10 %, 5 = halfway, 0 = start</string>
    <string name="remote_buttons_added">Set up on this box</string>

    <string name="remote_buttons_learn_title">Set up a button</string>
    <string name="remote_buttons_learn_subtitle">Press the button on your remote you want to give a job. Back cancels.</string>
    <string name="remote_buttons_learn_waiting">Waiting for a button…</string>
    <string name="remote_buttons_learn_nothing">Nothing arrived yet. Some buttons, like Home, the microphone, volume and the Netflix or YouTube buttons, belong to your box and never reach the app. If you use your TV\'s remote, your TV may not pass this button on to the box. Try another button, or free that one up with a button-mapper app such as tvQuickActions.</string>
    <string name="remote_buttons_learn_locked">%1$s can\'t be changed. OK, the arrows and Back always keep their usual jobs, so nobody gets stuck in the player. Press a different button.</string>
    <string name="remote_buttons_learn_volume">Volume stays with your box or TV. Press a different button.</string>

